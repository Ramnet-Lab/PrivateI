# Copy to .env and fill in.  .env is gitignored.  ./start.sh does all of this
# for you - edit here only to change a decision it made.

# --- required ----------------------------------------------------------------
# Neo4j refuses passwords under 8 characters. start.sh generates one.
NEO4J_PASSWORD=

# Models, as Docker Model Runner references (docker model pull <name>).
#   TEXT_MODEL   reads page text into facts, answers chat, writes reports
#   VLM_MODEL    reads handwriting and scans (may be the same model as TEXT)
#   EMBED_MODEL  indexes passages so chat and reports find the right pages
TEXT_MODEL=ai/gemma4
VLM_MODEL=ai/gemma4
EMBED_MODEL=ai/nomic-embed-text-v1.5

# --- inference -----------------------------------------------------------------
# Docker Model Runner executes models natively on this machine (GPU on a Mac),
# and containers reach it at this address. Point elsewhere only if you know
# what you are doing - any OpenAI-compatible /v1 endpoint works.
MODEL_URL=http://model-runner.docker.internal/v1
EMBED_MODEL_URL=http://model-runner.docker.internal/v1
# Seconds before a single model call is abandoned. With uncapped output below,
# this is the only bound on a runaway generation.
OLLAMA_TIMEOUT=1800
OLLAMA_RETRIES=3

# Reply-length caps. 0 means no cap, which is the default: these are reasoning
# models, thinking and answer share one budget, and a cap cuts the answer short
# rather than the thinking. Set a positive number only to bound cost.
EXTRACT_NUM_PREDICT=0
CHAT_NUM_PREDICT=0
REPORT_NUM_PREDICT=0
TRANSCRIBE_NUM_PREDICT=0
MODEL_THINKING=false
VLM_TEMPERATURE=0
TEXT_TEMPERATURE=0
VLM_NUM_CTX=8192
TEXT_NUM_CTX=16384

# --- reading documents -----------------------------------------------------------
PDF_DPI=300
USE_EMBEDDED_TEXT_LAYER=true
EMBEDDED_TEXT_MIN_CHARS=120
OCR_CONFIDENCE_THRESHOLD=82
OCR_MIN_WORDS=25
TESSERACT_LANG=eng

# --- linking -----------------------------------------------------------------------
MERGE_THRESHOLD=88

# --- app ---------------------------------------------------------------------------
APP_PORT=8080
MAX_UPLOAD_MB=500
NEO4J_HEAP=2G
NEO4J_PAGECACHE=1G
