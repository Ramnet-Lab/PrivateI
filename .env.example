# Copy to .env and fill in.  .env is gitignored.  ./start.sh does all of this
# for you - edit here only to change a decision it made.

# --- required ----------------------------------------------------------------
# Neo4j refuses passwords under 8 characters. start.sh generates one.
NEO4J_PASSWORD=

# Models, as Docker Model Runner references (docker model pull <name>).
#   TEXT_MODEL   reads page text into facts, answers chat, writes reports, AND
#                reads scans and handwriting - transcription asks for the model
#                on the settings page like every other stage, so pointing text
#                at your own endpoint points vision there too. There is no
#                separate vision model to set.
#   EMBED_MODEL  indexes passages so chat and reports find the right pages.
#                Always runs here, whatever the settings page says about text:
#                an index is only comparable with itself, so the model that
#                built it cannot change under it.
#
# Name the size explicitly rather than taking :latest. A tag that moves changes
# which model wrote a report without changing anything anybody can see, and for
# EMBED_MODEL it silently changes the vector space the existing index was built
# in - which does not error, it just retrieves worse.
TEXT_MODEL=ai/gemma4:12b
EMBED_MODEL=ai/qwen3-embedding:4b


# --- inference -----------------------------------------------------------------
# Docker Model Runner executes models natively on this machine (GPU on a Mac),
# and containers reach it at this address. Point elsewhere only if you know
# what you are doing - any OpenAI-compatible /v1 endpoint works.
MODEL_URL=http://model-runner.docker.internal/v1
EMBED_MODEL_URL=http://model-runner.docker.internal/v1
# Seconds before a single model call is abandoned. With uncapped output below,
# this is the only bound on a runaway generation.
OLLAMA_TIMEOUT=1800
OLLAMA_RETRIES=3

# Reply-length caps. 0 means no cap, which is the default: these are reasoning
# models, thinking and answer share one budget, and a cap cuts the answer short
# rather than the thinking. Set a positive number only to bound cost.
EXTRACT_NUM_PREDICT=0
CHAT_NUM_PREDICT=0
REPORT_NUM_PREDICT=0
TRANSCRIBE_NUM_PREDICT=0
MODEL_THINKING=false
VLM_TEMPERATURE=0
TEXT_TEMPERATURE=0
# How much prompt the text model can hold, and what the local Model Runner is
# told to load it with on every build.
#
# Model Runner has no small default: left alone it loads a model at that
# model's OWN trained context - measured, ai/gemma4:12b at 262144 and
# ai/qwen3-embedding:4b at 40960 - and the cache is allocated eagerly, so an
# unnecessarily large window costs gigabytes before a single request. A number
# here therefore imposes a budget rather than removing a cap.
#
# Nor does this backend truncate: llama.cpp ships with context shift disabled,
# so an over-long prompt is refused with both numbers named rather than having
# its front eaten. The risk is a window too SMALL for a real prompt.
#
# Measured on a worked case, real prompts run 15k-78k tokens. 131072 covers the
# largest observed with room to spare, at roughly 11 GiB resident. Leave it
# empty and scripts/pull-models.sh sizes it from this machine's RAM; set it and
# it is obeyed exactly. The window is shared across the four requests the
# runner serves at once.
#
# EMBED_NUM_CTX is a saving, not a cost: passages are about 250 tokens, so the
# embedder's own 40960 default spends gigabytes of cache on nothing.
VLM_NUM_CTX=8192
TEXT_NUM_CTX=131072
EMBED_NUM_CTX=8192

# --- Word files ------------------------------------------------------------------
# A .docx has no pages until something lays it out, so it is rendered to PDF
# and read from that: real page numbers, and headers, footers, footnotes, list
# numbering and field values on the page they belong to. The file is ALSO read
# directly from its own XML and the two are reconciled, because a renderer
# prints the display view - comments, tracked deletions and hidden text are not
# on a printed page. Anything the file holds that no rendered page carries is
# written to an annex page rather than dropped.
#
# DOCX_CONVERT=0 turns the rendering off. The XML read then becomes the pages,
# with Word's own page numbers where the file records them. Set it if you would
# rather not carry LibreOffice in the image.
DOCX_CONVERT=1
DOCX_CONVERT_TIMEOUT=300
# Pages to assume per character when a file has never been laid out by Word and
# so records no pagination of its own.
DOCX_ESTIMATED_PAGE_CHARS=2800
# Pictures smaller than this on their shortest side are decoration, not
# evidence, and are not worth a page of their own for OCR to read.
DOCX_PICTURE_MIN_SIDE=400

# --- reading documents -----------------------------------------------------------
PDF_DPI=300
USE_EMBEDDED_TEXT_LAYER=true
EMBEDDED_TEXT_MIN_CHARS=120
OCR_CONFIDENCE_THRESHOLD=82
OCR_MIN_WORDS=25
TESSERACT_LANG=eng

# --- linking -----------------------------------------------------------------------
MERGE_THRESHOLD=88

# --- app ---------------------------------------------------------------------------
APP_PORT=8080
MAX_UPLOAD_MB=500
NEO4J_HEAP=2G
NEO4J_PAGECACHE=1G
